# Environment
NODE_ENV=development
PORT=3001

# Database (Docker Compose)
DATABASE_URL="postgresql://postgres:postgres@postgres:5432/autoblog"    # postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
DB_HOST=postgres
DB_PORT=5432
DB_NAME=autoblog
DB_USER=postgres
DB_PASSWORD=postgres
DB_MAX_CONNECTIONS=20

# Database (Local Development)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/autoblog
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=autoblog
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_MAX_CONNECTIONS=20

# AI Service
HUGGINGFACE_API_KEY=your_huggingface_api_key_here
HUGGINGFACE_MODEL=meta-llama/Llama-3.3-70B-Instruct:scaleway

# AI Author
AI_AUTHOR_NAME=AI Assistant
AI_AUTHOR_SLUG=ai-assistant
AI_AUTHOR_ROLE=Content Generator
AI_AUTHOR_BIO=An AI-powered content creation assistant
AI_AUTHOR_AVATAR=https://api.dicebear.com/7.x/bottts/svg?seed=ai

# Feature Flags
AI_GENERATION_ENABLED=true
ARTICLE_AUTO_PUBLISH=true

# CORS
CORS_ORIGIN=http://localhost:5173

# Logging
LOG_LEVEL=debug